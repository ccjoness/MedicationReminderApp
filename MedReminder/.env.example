# Copy this file to .env and fill in your values.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ── Google Sign-In (native SDK) ───────────────────────────────────────────────
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID
#   The "Web application" OAuth client ID from Google Cloud Console.
#   Used on Android to request an ID token, and passed to Supabase signInWithIdToken.
#   Google Cloud Console → Credentials → Web application client
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID
#   The "iOS" OAuth client ID from Google Cloud Console.
#   Google Cloud Console → Credentials → Create OAuth client ID → iOS
#   Bundle ID: com.darkmattersoftware.lumidose
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com

# GOOGLE_IOS_URL_SCHEME  (build-time only — NOT prefixed with EXPO_PUBLIC_)
#   The reversed iOS client ID. Used in app.config.js for the iOS URL scheme.
#   Format: com.googleusercontent.apps.YOUR_IOS_CLIENT_ID_PREFIX
#   Example: if iosClientId = "12345-abc.apps.googleusercontent.com"
#            then GOOGLE_IOS_URL_SCHEME = "com.googleusercontent.apps.12345-abc"
#   Add this to EAS secrets (eas secret:create) as well as your local .env.
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.YOUR_IOS_CLIENT_ID_PREFIX
