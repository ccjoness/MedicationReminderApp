# Copy this file to .env and fill in your values.
# Add all of these to EAS secrets as well: eas secret:create --name KEY --value "value"

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ── Google Sign-In (native Android SDK) ──────────────────────────────────────
# Found in: Google Cloud Console → Credentials
#
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID
#   The "Web application" OAuth client ID.
#   Required on Android so the native Sign-In SDK can request an ID token.
#   This ID token is passed to supabase.auth.signInWithIdToken().
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
